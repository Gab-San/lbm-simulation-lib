#!/bin/bash
#PBS -N lbm_properties
#PBS -q cpu
#PBS -l select=1:ncpus=16
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o logs/

echo "Running: $EXE"

cd "$PBS_O_WORKDIR"

if [ ! -x ${EXE} ]; then
  echo "ERROR: build/simulations/properties_test not found." \
       "Run submit_properties.sh first (it builds once before" \
       "submitting) or build manually." >&2
  exit 1
fi

# Node-local scratch: faster than NFS for I/O
WORKDIR=/scratch_local/${PBS_JOBID}
mkdir -p "$WORKDIR"
trap 'rm -rf "$WORKDIR"' EXIT
cp ${EXE} "$WORKDIR"/
cp ${CONFIG} "$WORKDIR"/
cd "$WORKDIR"

mkdir -p out
exefilename="${EXE##*/}"   # Removes path -> my.document.txt

configfilename="${CONFIG##*/}"

./"$exefilename" "$configfilename"

# Copy results back: a folder dedicated to this job (unique JOBID)
mkdir -p "$PBS_O_WORKDIR"/results/"${PBS_JOBID}"
cp -r out/* "$PBS_O_WORKDIR"/results/"${PBS_JOBID}"/
