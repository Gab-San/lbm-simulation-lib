#!/bin/bash

#PBS -N lbm_cuda_simulation
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o logs/

EXE_NAME="$1"
echo "Running: $EXE_NAME"

cd "$PBS_O_WORKDIR"

# The binary must already exist under build/cuda/simulations/ (the CUDA
# build tree - separate from build/simulations/, which is the CPU build).
# Building it here on demand repeats the race from the CPU jobs, and worse:
# the previous check ("[ ! -x $1 ]") tested for a bare filename in
# $PBS_O_WORKDIR, which never exists there, so it was ALWAYS true - every
# job rebuilt every time, all racing on the same shared build/.
BIN_PATH="build/cuda/simulations/$EXE_NAME"
if [ ! -x "$BIN_PATH" ]; then
  echo "ERROR: $BIN_PATH not found or not executable." \
       "Build first with:" \
       "cmake -S . -B build -DLBM_ENABLE_CUDA=ON && cmake --build build -j2" >&2
  exit 1
fi

# Node-local scratch: faster than NFS for I/O
WORKDIR=/scratch_local/${PBS_JOBID}
mkdir -p "$WORKDIR"
trap 'rm -rf "$WORKDIR"' EXIT
cp "$BIN_PATH" "$WORKDIR"/
cp configs/profiling.toml "$WORKDIR"/
cd "$WORKDIR"

mkdir -p out
./"$EXE_NAME" profiling.toml

# Copy results back: a folder dedicated to this job (unique JOBID)
mkdir -p "$PBS_O_WORKDIR"/results/"${PBS_JOBID}"
cp -r out/* "$PBS_O_WORKDIR"/results/"${PBS_JOBID}"/
