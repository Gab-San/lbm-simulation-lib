#!/bin/bash
#PBS -N lbm_properties
#PBS -q cpu
#PBS -l select=1:ncpus=16
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o logs/
# -o as a directory (trailing slash): PBS writes <jobname>.o<jobid> there.
# With -j oe both stdout and stderr are merged into that same file, so -e
# is not needed. This is explicit on purpose - relying on the site's
# default output location is exactly what left you with no log to check.
# "logs/" is resolved relative to the directory qsub was run from
# (submit_properties.sh creates it and cd's there before calling qsub).

EXE=$1

cd "$PBS_O_WORKDIR"

# The binary must already exist: submit_properties.sh builds it ONCE,
# before submitting. If each job rebuilds it on demand instead, N jobs
# launched together all find it missing and end up running "cmake --build"
# in parallel against the same shared build/ (NFS) -> a corrupted build,
# and without `set -e` the job would carry on anyway, copying back an
# empty out/ with no error.
if [ ! -x ${EXE} ]; then
  echo "ERROR: build/simulations/properties_test not found." \
       "Run submit_properties.sh first (it builds once before" \
       "submitting) or build manually." >&2
  exit 1
fi

# Node-local scratch: faster than NFS for I/O
WORKDIR=/scratch_local/${PBS_JOBID}
mkdir -p "$WORKDIR"
trap 'rm -rf "$WORKDIR"' EXIT
cp ${EXE} "$WORKDIR"/
cp configs/profiling.toml "$WORKDIR"/
cd "$WORKDIR"

mkdir -p out
filename="${EXE##*/}"   # Removes path -> my.document.txt
stem="${filename%.*}"    # Removes extension -> my.document

./${stem} profiling.toml

# Copy results back: a folder dedicated to this job (unique JOBID)
mkdir -p "$PBS_O_WORKDIR"/results/"${PBS_JOBID}"
cp -r out/* "$PBS_O_WORKDIR"/results/"${PBS_JOBID}"/
