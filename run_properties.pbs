#!/bin/bash
#PBS -N lbm_properties
#PBS -q cpu
#PBS -l select=1:ncpus=16
#PBS -l walltime=00:30:00
#PBS -j oe

cd "$PBS_O_WORKDIR" || exit 1

# Build the binary if it does not exist yet (once the build has been done, the
# following runs find it ready in build/simulations and skip this step).
if [ ! -x build/simulations/properties_test ]; then
  cd build
  cmake --build . --target properties_test -j"$(nproc)"
  cd ..
fi

# Node-local scratch: faster than NFS for I/O.
WORKDIR=/scratch_local/${PBS_JOBID}
mkdir -p "$WORKDIR"
cp build/simulations/properties_test "$WORKDIR"/
cp configs/profiling.toml "$WORKDIR"/
cd "$WORKDIR" || exit 1

mkdir -p out
./properties_test profiling.toml

# Copy the results back: one directory per job (JOBID is unique).
mkdir -p "$PBS_O_WORKDIR"/results/"${PBS_JOBID}"
cp -r out/* "$PBS_O_WORKDIR"/results/"${PBS_JOBID}"/

cd "$PBS_O_WORKDIR" || exit 1
rm -rf "$WORKDIR"
